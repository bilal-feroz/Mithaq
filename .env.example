# ── MITHAQ Gate environment ──────────────────────────────────────────────
# Copy to .env.local and fill in what you have.
# Every value below is OPTIONAL for demo mode: with an empty environment the
# app boots with the local demo store, the mock extraction adapter and the
# mock voice provider. Never commit a file containing real secrets.

NEXT_PUBLIC_APP_URL=

# ── Supabase (optional — local demo store is used when absent) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Decision token signing ───────────────────────────────────────────────
# HMAC-SHA256 secret for single-use authorization tokens.
# Required in production. In demo mode an ephemeral per-boot secret is
# generated and a warning is logged.
DECISION_TOKEN_SECRET=

# ── AI consent extraction ────────────────────────────────────────────────
# mock | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Voice generation provider ────────────────────────────────────────────
# mock | elevenlabs
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
